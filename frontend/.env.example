# Copy to .env.local (gitignored). Supabase Auth needs the existing project's
# URL and public/publishable key. Never put a service-role key in this file.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Point the UI at a specific backend origin (e.g. production API).
# VITE_API_BASE_URL=http://127.0.0.1:8000

# One-click judge demo sign-in (Phase 1a). Hide the "Try as …" buttons on the
# login/signup screens when none of these pairs are configured. Use placeholder
# values only — never commit real credentials.
# VITE_DEMO_STUDENT_EMAIL=demo.student@hosteldesk.dev
# VITE_DEMO_STUDENT_PASSWORD=<placeholder>
# VITE_DEMO_WARDEN_EMAIL=demo.warden@hosteldesk.dev
# VITE_DEMO_WARDEN_PASSWORD=<placeholder>
# VITE_DEMO_WORKER_EMAIL=demo.worker@hosteldesk.dev
# VITE_DEMO_WORKER_PASSWORD=<placeholder>

# Demo role switcher and walkthrough gating (Phase 1c/1d). Compares the signed-in
# email against these values (case-insensitive).
# VITE_DEMO_STUDENT_EMAIL=demo.student@hosteldesk.dev
# VITE_DEMO_WARDEN_EMAIL=demo.warden@hosteldesk.dev
# VITE_DEMO_WORKER_EMAIL=demo.worker@hosteldesk.dev
