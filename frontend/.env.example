# Copy to .env.local (gitignored) only for custom setups. The vite dev proxy
# (see vite.config.js) already forwards /complaints to http://127.0.0.1:8000,
# so development works out of the box without any of these values.

# Point the UI at a specific backend origin (e.g. production API).
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Demo auth: id of the seeded demo STUDENT user the UI submits as
# (backend seed: 1 = student1). The value travels in the X-User-Id header.
# VITE_DEMO_STUDENT_ID=1
