# Copy to .env and fill in real values. Never commit the real .env.

# ---------------------------------------------------------------------------
# Relational database - Supabase PostgreSQL (Project Settings > Database).
# Keep the SQLAlchemy driver prefix: postgresql+psycopg2://
#   Direct:      postgresql+psycopg2://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#   Pooler IPv4: postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg2://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Supabase - server-side only. NEVER expose SUPABASE_SERVICE_ROLE_KEY to React;
# every Storage call goes through FastAPI.
# SUPABASE_URL comes from Project Settings > API > Project URL.
# Leave both empty to run photo storage on the local uploads/ fallback.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=complaint-photos

# ---------------------------------------------------------------------------
# Gemini / Gemma - server-side only, never in frontend code.
# Primary and fallback must BOTH be free-tier Gemma models.
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-31b-it
GEMINI_FALLBACK_MODEL=gemma-4-26b-a4b-it

# Gemini request timeout in seconds (classification is a small JSON task).
# If the model does not answer within this, AI is marked failed and the
# complaint stays in WARDEN_REVIEW for manual warden review.
AI_REQUEST_TIMEOUT_SECONDS=10

# Maximum output tokens for the model response. Compact JSON only; no
# chain-of-thought is stored or logged.
GEMINI_MAX_OUTPUT_TOKENS=512

# Maximum image size in MB sent to Gemini. Larger images are downsized
# (Pillow required) before the model request.
MAX_AI_IMAGE_MB=1

# ---------------------------------------------------------------------------
# Frontend development origin (comma-separated list allowed).
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Deterministic rules.
# A task older than TASK_OVERDUE_HOURS (ASSIGNED / IN_PROGRESS) is overdue.
TASK_OVERDUE_HOURS=24
MAX_IMAGE_SIZE_MB=5
