# Copy to .env and fill in real values. Never commit the real .env.

# ---------------------------------------------------------------------------
# Runtime connection for FastAPI. Use the dedicated non-owner application role.
# Keep the SQLAlchemy driver prefix: postgresql+psycopg2://
DATABASE_URL=postgresql+psycopg2://hosteldesk_app:<password>@db.<project-ref>.supabase.co:5432/postgres
# Database role used by FastAPI; the migration adds request-scoped RLS policies for it.
APPLICATION_DB_ROLE=hosteldesk_app
# Optional owner-level connection used only to apply Alembic migrations.
MIGRATION_DATABASE_URL=

# ---------------------------------------------------------------------------
# Supabase - server-side only. NEVER expose SUPABASE_SERVICE_ROLE_KEY to React;
# every Storage call and confirmed-user signup go through FastAPI.
# SUPABASE_URL comes from Project Settings > API > Project URL.
# Leave both empty to run photo storage on the local uploads/ fallback.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Public Auth client key. This may also be named NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# in an existing local configuration; it is accepted by the backend for Auth verification.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_STORAGE_BUCKET=complaint-photos

# ---------------------------------------------------------------------------
# Gemini - server-side only, never in frontend code.
# Default: Gemini 2.5 Flash with 2.5 Flash-Lite as fallback (Google API keys do
# not expose Gemma 4 yet; switching back later is a config change, e.g.
# GEMINI_MODEL=gemma-4-31b-it).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Gemini request timeout in seconds (classification is a small JSON task).
# If the model does not answer within this, AI is marked failed and the
# complaint stays in WARDEN_REVIEW for manual warden review.
AI_REQUEST_TIMEOUT_SECONDS=10

# Maximum output tokens for the model response. Compact JSON only; no
# chain-of-thought is stored or logged.
GEMINI_MAX_OUTPUT_TOKENS=512

# Maximum image size in MB sent to Gemini. Larger images are downsized
# (Pillow required) before the model request.
MAX_AI_IMAGE_MB=1

# ---------------------------------------------------------------------------
# Frontend development origin (comma-separated list allowed).
CORS_ORIGINS=http://localhost:5173,https://hosteldesk.aurio.workers.dev

# ---------------------------------------------------------------------------
# Deterministic rules.
# A task older than the SLA for its severity (ASSIGNED / IN_PROGRESS) is
# overdue. Per-severity values override TASK_OVERDUE_HOURS (the fallback).
TASK_OVERDUE_HOURS=24
TASK_OVERDUE_HOURS_HIGH=4
TASK_OVERDUE_HOURS_MEDIUM=24
TASK_OVERDUE_HOURS_LOW=72

# Complaints waiting for warden review longer than this are "stale review"
# in the daily digest.
STALE_REVIEW_HOURS=4

# Optional: reword the rules-based digest with one Gemini text call
# (counters only, never student names or photos). Set to false to keep the
# deterministic summary only.
DIGEST_AI_POLISH=true

# ---------------------------------------------------------------------------
# Abuse limits (in-memory sliding window, per backend process).
# Student: max complaints per 10 minutes and per day.
COMPLAINT_RATE_LIMIT_10MIN=5
COMPLAINT_RATE_LIMIT_DAILY=20
# Signups: max per hour per client IP (X-Forwarded-For first hop).
SIGNUP_RATE_LIMIT_HOURLY=10

# ---------------------------------------------------------------------------
# Staff invite code. Required for Warden/Worker signup; student signup stays
# open. Leave EMPTY to disable staff signup entirely. Never commit a real
# code - set it only in the real environment (Render/Cloudflare secrets).
STAFF_INVITE_CODE=
MAX_IMAGE_SIZE_MB=5
